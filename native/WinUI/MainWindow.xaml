<Window x:Class="AutoMusicPlayer.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:AutoMusicPlayer">
 <Grid x:Name="Root">
  <Grid.Resources>
   <Style TargetType="TextBlock" x:Key="Muted"><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
   <Style TargetType="Border" x:Key="Card"><Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" /><Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="24" /></Style>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /><RowDefinition Height="36" /></Grid.RowDefinitions>
  <Grid x:Name="TitleBar" Background="Transparent" Padding="20,0,150,0">
   <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><FontIcon Glyph="&#xE8D6;" FontSize="16" Foreground="#C48A24" /><TextBlock Text="自动演奏器" FontSize="14" FontWeight="SemiBold" /><TextBlock Text="LITE" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="2,0,0,0" /></StackPanel>
  </Grid>
  <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Left" OpenPaneLength="200" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False" IsSettingsVisible="True" SelectionChanged="NavigationChanged" AlwaysShowHeader="False">
   <NavigationView.MenuItems>
    <NavigationViewItem Content="乐谱库" Tag="library"><NavigationViewItem.Icon><SymbolIcon Symbol="Library" /></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="演奏控制" Tag="player"><NavigationViewItem.Icon><SymbolIcon Symbol="Play" /></NavigationViewItem.Icon></NavigationViewItem>
    <NavigationViewItem Content="演奏记录" Tag="logs"><NavigationViewItem.Icon><SymbolIcon Symbol="Clock" /></NavigationViewItem.Icon></NavigationViewItem>
   </NavigationView.MenuItems>
   <NavigationView.PaneFooter>
    <StackPanel Margin="20,16,16,24" Spacing="6"><TextBlock Text="F6  开始 / 继续" Style="{StaticResource Muted}" FontSize="12" /><TextBlock Text="F8  暂停演奏" Style="{StaticResource Muted}" FontSize="12" /><TextBlock Text="WinUI 3 · v2.2.0" Style="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0" /></StackPanel>
   </NavigationView.PaneFooter>
   <Grid Margin="28,20,28,20">
    <Grid x:Name="LibraryPage" RowSpacing="20">
     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
     <Grid><StackPanel Spacing="6"><TextBlock Text="乐谱库" Style="{ThemeResource TitleTextBlockStyle}" /><TextBlock x:Name="LibraryCount" Text="你的曲目，随时演奏。" Style="{StaticResource Muted}" /></StackPanel></Grid>
     <Grid Grid.Row="1" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <AutoSuggestBox x:Name="SearchBox" PlaceholderText="搜索曲名" QueryIcon="Find" TextChanged="SearchChanged" />
      <ComboBox x:Name="SortBox" Grid.Column="1" SelectedIndex="1" HorizontalAlignment="Stretch" SelectionChanged="SortChanged"><ComboBoxItem Content="添加时间 · 升序" /><ComboBoxItem Content="添加时间 · 倒序" /><ComboBoxItem Content="更新时间 · 升序" /><ComboBoxItem Content="更新时间 · 倒序" /><ComboBoxItem Content="曲名拼音 · A–Z" /><ComboBoxItem Content="曲名拼音 · Z–A" /></ComboBox>
      <Button Grid.Column="2" Content="导入乐谱" Click="ImportClick" />
      <Button Grid.Column="3" Content="更多"><Button.Flyout><MenuFlyout><MenuFlyoutItem Text="批量导入文件夹" Click="BatchClick" /><MenuFlyoutItem Text="新建简谱" Click="NewClick" /><MenuFlyoutItem Text="导入旧版数据库" Click="ImportDatabaseClick" /></MenuFlyout></Button.Flyout></Button>
     </Grid>
     <Grid Grid.Row="2" ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TabView x:Name="LibraryTabs" Height="48" TabWidthMode="SizeToContent" IsAddTabButtonVisible="True" SelectionChanged="LibraryTabChanged" AddTabButtonClick="AddLibraryTab" /><ToggleButton x:Name="MultiSelectButton" Grid.Column="1" Content="多选" Click="MultiSelectClick" VerticalAlignment="Top" /></Grid>
     <StackPanel x:Name="BatchToolbar" Grid.Row="3" Visibility="Collapsed" Orientation="Horizontal" Spacing="8"><TextBlock x:Name="BatchCount" Text="已选 0 首" VerticalAlignment="Center" /><Button Content="全选" Click="SelectAllClick" /><Button Content="清空" Click="ClearSelectionClick" /><Button x:Name="BatchGroupButton" Content="加入分组" Click="BatchGroupClick" /><Button x:Name="BatchRemoveButton" Content="移出当前组" Click="BatchRemoveClick" /><Button x:Name="BatchFavoriteButton" Content="收藏" Tag="on" Click="BatchFavoriteClick" /><Button x:Name="BatchExportButton" Content="导出 ZIP" Click="BatchExportClick" /><Button x:Name="BatchUnfavoriteButton" Content="取消收藏" Tag="off" Click="BatchFavoriteClick" /></StackPanel>
     <Grid Grid.Row="4" ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="6">
       <Grid ColumnSpacing="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ListView x:Name="SongsList" SelectionMode="Single" SelectionChanged="SongSelected" DoubleTapped="SongDoubleTapped">
        <ListView.ItemTemplate><DataTemplate x:DataType="local:SongItem"><Grid Padding="12,10" ColumnSpacing="14"><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon Glyph="&#xE8D6;" FontSize="18" Opacity="0.55" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Spacing="5"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{x:Bind FavoriteMark}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" /><TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /></StackPanel><TextBlock Text="{x:Bind Subtitle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" /></StackPanel></Grid></DataTemplate></ListView.ItemTemplate>
       </ListView><ScrollViewer x:Name="AlphabetRail" Grid.Column="1" Visibility="Collapsed" VerticalScrollBarVisibility="Hidden" SizeChanged="AlphabetSizeChanged"><StackPanel x:Name="AlphabetButtons" Spacing="0" /></ScrollViewer><StackPanel x:Name="EmptyLibrary" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" IsHitTestVisible="False"><FontIcon Glyph="&#xE8D6;" FontSize="36" Opacity="0.4" /><TextBlock x:Name="EmptyLibraryText" Text="导入本地乐谱，开始第一首演奏" Style="{StaticResource Muted}" TextAlignment="Center" /></StackPanel></Grid>
      </Border>
      <StackPanel Grid.Column="1" Spacing="18">
       <Border Style="{StaticResource Card}"><StackPanel Spacing="16"><TextBlock Text="当前曲目" Style="{StaticResource Muted}" FontSize="12" /><TextBlock x:Name="SelectedTitle" Text="尚未选择" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock x:Name="SelectedMeta" Text="从左侧选择一首曲目。" Style="{StaticResource Muted}" /><Button x:Name="GoButton" Content="去演奏" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="GoClick" IsEnabled="False" /><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button x:Name="EditButton" Content="编辑" HorizontalAlignment="Stretch" Click="EditClick" IsEnabled="False" /><Button x:Name="ExportButton" Grid.Column="1" Content="导出" HorizontalAlignment="Stretch" Click="ExportClick" IsEnabled="False" /></Grid><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button x:Name="FavoriteButton" Content="收藏曲目" Click="FavoriteClick" HorizontalAlignment="Stretch" IsEnabled="False" /><Button x:Name="SongGroupsButton" Grid.Column="1" Content="设置分组" Click="SongGroupsClick" HorizontalAlignment="Stretch" IsEnabled="False" /></Grid><Button x:Name="DeleteButton" Content="删除曲目" HorizontalAlignment="Stretch" Click="DeleteClick" IsEnabled="False" /></StackPanel></Border>
       <TextBlock Text="先试听，再演奏。开始后的 3 秒内切换到游戏窗口；F8 可随时暂停。" Style="{StaticResource Muted}" FontSize="12" Margin="4,0" />
      </StackPanel>
     </Grid>
    </Grid>
    <ScrollViewer x:Name="PlayerPage" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Spacing="22" MaxWidth="1050" HorizontalAlignment="Stretch">
      <Grid><StackPanel Spacing="6"><TextBlock Text="演奏控制" Style="{ThemeResource TitleTextBlockStyle}" /><TextBlock Text="调整节奏，让每个音符落在合适的位置。" Style="{StaticResource Muted}" /></StackPanel><Button Content="演奏小窗" HorizontalAlignment="Right" VerticalAlignment="Center" Click="MiniClick" /></Grid>
      <Border Style="{StaticResource Card}"><StackPanel Spacing="14"><ComboBox x:Name="PlayerSong" Header="当前曲目" DisplayMemberPath="Name" HorizontalAlignment="Stretch" SelectionChanged="PlayerSongChanged" /><TextBlock x:Name="ScoreDescription" Text="先在乐谱库选择一首曲目。" Style="{StaticResource Muted}" /></StackPanel></Border>
      <Border Style="{StaticResource Card}" Padding="20,12"><Grid ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center" Spacing="4"><TextBlock x:Name="SpeedLabel" Text="全局倍速 · 1.00×" FontWeight="SemiBold" /><TextBlock Text="演奏与试听共用" Style="{StaticResource Muted}" FontSize="12" /></StackPanel><Slider x:Name="SpeedSlider" Grid.Column="1" Minimum="0.5" Maximum="3" Value="1" StepFrequency="0.001" SmallChange="0.01" ValueChanged="SpeedChanged" /><TextBlock x:Name="EffectiveBpmText" Grid.Column="2" Text="实际 100 BPM" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center" /></Grid></Border>
      <Grid x:Name="SettingsGrid" ColumnSpacing="20" RowSpacing="20"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
       <Border x:Name="PlaybackSettingsCard" Style="{StaticResource Card}"><StackPanel Spacing="18"><TextBlock Text="演奏设置" FontSize="18" FontWeight="SemiBold" /><StackPanel Spacing="6"><TextBlock Text="乐器" FontSize="13" /><TextBlock Text="三角洲行动 · 守夜人口琴" FontSize="16" FontWeight="SemiBold" /></StackPanel><ComboBox x:Name="ProfileBox" Visibility="Collapsed" DisplayMemberPath="Name" SelectionChanged="ProfileChanged" /><ComboBox x:Name="ModeBox" Header="演奏模式" HorizontalAlignment="Stretch" SelectedIndex="0"><ComboBoxItem Content="自动演奏" Tag="play" /><ComboBoxItem Content="练习 · 按提示自行输入" Tag="practice" /></ComboBox><ComboBox x:Name="ScenarioBox" Header="三角洲场景" HorizontalAlignment="Stretch" SelectedIndex="0"><ComboBoxItem Content="自由演奏" Tag="free_play" /><ComboBoxItem Content="NPC 听旋律任务" Tag="npc_quest" /></ComboBox><NumberBox x:Name="BpmBox" Header="速度 · BPM" Minimum="30" Maximum="300" Value="100" SpinButtonPlacementMode="Inline" /><NumberBox x:Name="TransposeBox" Header="移调 · 半音" Minimum="-24" Maximum="24" Value="0" SpinButtonPlacementMode="Inline" /></StackPanel></Border>
       <Border x:Name="RhythmSettingsCard" Grid.Column="1" Style="{StaticResource Card}"><StackPanel Spacing="18"><TextBlock Text="节奏与片段" FontSize="18" FontWeight="SemiBold" /><ToggleSwitch x:Name="HumanizeSwitch" Header="真人化节奏" OnContent="开启" OffContent="关闭" IsOn="True" /><NumberBox x:Name="LatencyBox" Header="延迟补偿 · ms" Minimum="0" Maximum="200" Value="0" SpinButtonPlacementMode="Inline" /><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><NumberBox x:Name="StartBox" Header="起始元素" Minimum="1" Value="1" SpinButtonPlacementMode="Compact" /><NumberBox x:Name="EndBox" Grid.Column="1" Header="结束元素" Minimum="1" Value="1" SpinButtonPlacementMode="Compact" /></Grid><TextBlock Text="元素编号包含音符、和弦和休止。结束元素会参与演奏。" Style="{StaticResource Muted}" FontSize="12" /><TextBlock Text="NPC 任务采用固定节奏，中断后需重新听 NPC 示范。" Style="{StaticResource Muted}" FontSize="12" /></StackPanel></Border>
      </Grid>
      <Border Style="{StaticResource Card}"><StackPanel Spacing="14"><Grid><TextBlock x:Name="PlaybackMessage" Text="准备就绪" FontWeight="SemiBold" /><TextBlock x:Name="ProgressText" Text="0 / 0" HorizontalAlignment="Right" Style="{StaticResource Muted}" /></Grid><Slider x:Name="SeekSlider" Minimum="0" Maximum="1" Value="0" StepFrequency="1" SmallChange="1" IsEnabled="False" ValueChanged="SeekChanged" /><StackPanel Orientation="Horizontal" Spacing="10"><Button x:Name="PlayButton" Content="开始演奏 · F6" Style="{StaticResource AccentButtonStyle}" Click="PlayClick" IsEnabled="False" /><Button x:Name="PauseButton" Content="暂停 · F8" Click="PauseClick" IsEnabled="False" /><Button Content="重置" Click="ResetClick" /><Button x:Name="PreviewButton" Content="钢琴试听" Click="PreviewClick" IsEnabled="False" /></StackPanel><TextBlock x:Name="TargetText" Style="{StaticResource Muted}" FontSize="12" /><InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Message="开始后的 3 秒内切回游戏。离开目标窗口会自动暂停并释放按键。" /></StackPanel></Border>
      <Border x:Name="PracticePanel" Style="{StaticResource Card}" Visibility="Collapsed"><StackPanel Spacing="12"><TextBlock Text="练习提示" FontSize="18" FontWeight="SemiBold" /><TextBlock x:Name="ScoreHint" FontSize="24" /><TextBlock x:Name="InputHint" FontSize="18" /><TextBlock x:Name="PracticeStats" Style="{StaticResource Muted}" /></StackPanel></Border>
     </StackPanel>
    </ScrollViewer>
    <Grid x:Name="LogsPage" Visibility="Collapsed" RowSpacing="20"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid><StackPanel Spacing="6"><TextBlock Text="演奏记录" Style="{ThemeResource TitleTextBlockStyle}" /><TextBlock Text="查看演奏进度、输入事件与节奏偏差。" Style="{StaticResource Muted}" /></StackPanel><Button Content="刷新" HorizontalAlignment="Right" Click="RefreshLogsClick" /></Grid><Grid Grid.Row="1" ColumnSpacing="20"><Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><ListView x:Name="LogList" DisplayMemberPath="Display" SelectionChanged="LogSelected" /><Border Grid.Column="1" Style="{StaticResource Card}"><Grid RowSpacing="14"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="导出 JSONL" Tag="jsonl" Click="ExportLogClick" /><Button Content="导出 CSV" Tag="csv" Click="ExportLogClick" /></StackPanel><TextBox Grid.Row="1" x:Name="LogDetail" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12" PlaceholderText="选择左侧记录查看详情" /></Grid></Border></Grid></Grid>
    <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed"><StackPanel Spacing="22" MaxWidth="760" HorizontalAlignment="Left"><TextBlock Text="设置" Style="{ThemeResource TitleTextBlockStyle}" /><Border Style="{StaticResource Card}"><StackPanel Spacing="16"><TextBlock Text="外观" FontSize="18" FontWeight="SemiBold" /><ComboBox x:Name="ThemeBox" Header="主题" Width="250" SelectedIndex="0" SelectionChanged="ThemeChanged"><ComboBoxItem Content="跟随系统" /><ComboBoxItem Content="浅色" /><ComboBoxItem Content="深色" /></ComboBox></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel Spacing="16"><TextBlock Text="权限与数据" FontSize="18" FontWeight="SemiBold" /><TextBlock x:Name="PermissionText" Style="{StaticResource Muted}" /><ToggleSwitch x:Name="AdminDefaultToggle" Header="默认以管理员身份启动" OnContent="下次启动自动请求管理员权限" OffContent="普通身份启动" Toggled="AdminDefaultToggled" /><ToggleSwitch x:Name="AdminReminderToggle" Header="普通权限运行时提醒" OnContent="每次启动提醒" OffContent="不再提醒" Toggled="AdminReminderToggled" /><Button Content="以管理员身份重新打开" Click="AdminClick" /><TextBlock Text="管理员授权取消或新窗口启动失败时，会保留当前窗口。提醒弹窗也可选择重启并设为默认。" Style="{StaticResource Muted}" FontSize="12" /><TextBlock Text="游戏以管理员运行时，播放器也需要相同权限。" Style="{StaticResource Muted}" FontSize="12" /><TextBlock Text="数据保存在当前用户的本地应用数据目录，升级和卸载会保留曲库。" Style="{StaticResource Muted}" /><TextBlock x:Name="DataPathText" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontSize="12" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="打开数据目录" Click="DataFolderClick" /><Button Content="导入旧版数据库" Click="ImportDatabaseClick" /></StackPanel></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="备份与恢复" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="将全部谱面、分组、收藏和设置保存为 backup ZIP。恢复前会自动备份当前数据。" Style="{StaticResource Muted}" /><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="BackupButton" Content="创建备份" Click="BackupClick" /><Button x:Name="RestoreBackupButton" Content="恢复备份" Click="RestoreBackupClick" /></StackPanel></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel Spacing="14"><TextBlock Text="软件更新" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="从本项目 GitHub Releases 获取稳定版本。下载后校验 SHA-256，确认安装后保留本地曲库。" Style="{StaticResource Muted}" /><ToggleSwitch x:Name="AutoUpdateToggle" Header="启动时自动检查更新" IsOn="True" Toggled="AutoUpdateToggled" /><TextBlock x:Name="UpdateStatusText" Text="当前版本 2.2.0" TextWrapping="Wrap" /><TextBlock x:Name="UpdateNotesText" TextWrapping="Wrap" MaxHeight="160" /><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="CheckUpdateButton" Content="检查更新" Click="CheckUpdateClick" /><Button x:Name="InstallUpdateButton" Content="下载并安装" Click="InstallUpdateClick" IsEnabled="False" /><Button Content="版本发布页" Click="ReleasePageClick" /></StackPanel></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel Spacing="12"><TextBlock Text="自动演奏器 Lite" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="2.2.0 · 原生 WinUI 3" /><TextBlock Text="仅适用于三角洲行动口琴。本地曲库、钢琴试听和游戏内演奏。免费开源，仅供个人学习与交流。" Style="{StaticResource Muted}" /><Button Content="开源许可与第三方声明" Click="LicensesClick" /></StackPanel></Border></StackPanel></ScrollViewer>
   </Grid>
  </NavigationView>
  <Grid Grid.Row="2" Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="20,0"><StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><ProgressRing x:Name="BusyRing" Width="14" Height="14" IsActive="False" /><TextBlock x:Name="StatusText" Text="正在启动本地引擎…" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" /></StackPanel></Grid>
 </Grid>
</Window>
